<section class="account section--ivory">
  <div class="container container--wide">
    <div class="account__head">
      <h1 class="display account__title">{{ 'customer.account' | t }}</h1>
      <a class="link-quiet" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
    </div>
    <div class="account__grid">
      <div>
        <h2 class="account__subtitle">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th scope="col">{{ 'customer.order' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.payment' | t }}</th><th scope="col">{{ 'customer.fulfillment' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.financial_status_label }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money_with_currency }}</td></tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <aside>
        <h2 class="account__subtitle">{{ 'customer.details' | t }}</h2>
        {{ customer.default_address | format_address }}
        <a class="link-arrow" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }}){% render 'icon', name: 'arrow-right', size: 16 %}</a>
      </aside>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
