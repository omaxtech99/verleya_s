{%- liquid
  assign networks = 'instagram,facebook,youtube,pinterest,x,whatsapp' | split: ','
-%}
<ul class="social" role="list">
  {%- for n in networks -%}
    {%- assign key = 'social_' | append: n -%}
    {%- if settings[key] != blank -%}
      <li><a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ n | capitalize }}">{% render 'icon', name: n, size: 18 %}</a></li>
    {%- endif -%}
  {%- endfor -%}
</ul>
