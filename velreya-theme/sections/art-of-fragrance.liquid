{%- assign s = section.settings -%}
<section class="compo" aria-labelledby="Compo-{{ section.id }}">
  <div class="container container--wide">
    <p class="eyebrow" id="Compo-{{ section.id }}" data-reveal>{{ s.eyebrow }}</p>
    <ol class="compo__list" role="list">
      {%- for block in section.blocks -%}
        <li class="compo__row compo__row--{{ forloop.index }}" {{ block.shopify_attributes }} data-scroll>
          <h3 class="compo__word{% if forloop.index == 2 %} compo__word--gold{% endif %}">{{ block.settings.title }}</h3>
          <div class="compo__copy">
            {%- if block.settings.timing != blank -%}<p class="eyebrow eyebrow--gold eyebrow--sm">{{ block.settings.timing }}</p>{%- endif -%}
            <p>{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "The art of composition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The Art of Composition" }
  ],
  "blocks": [
    { "type": "tier", "name": "Note tier", "settings": [
      { "type": "text", "id": "title", "label": "Word", "default": "Top" },
      { "type": "text", "id": "timing", "label": "Small label" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 3,
  "presets": [ { "name": "The art of composition", "blocks": [
    { "type": "tier", "settings": { "title": "Top", "timing": "The first impression", "text": "The notes you meet in the opening moments, bright and immediate." } },
    { "type": "tier", "settings": { "title": "Heart", "timing": "The character", "text": "What emerges as the opening settles and the fragrance shows its personality." } },
    { "type": "tier", "settings": { "title": "Base", "timing": "The foundation", "text": "The deeper notes that give the fragrance its depth and its memory." } }
  ] } ]
}
{% endschema %}
