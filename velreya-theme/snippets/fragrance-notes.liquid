{%- comment -%}
  Top / heart / base notes from product metafields (velreya.top_notes, velreya.heart_notes, velreya.base_notes).
  Accepts list.single_line_text_field or comma-separated single line text.
  Params: product, style ('stacked' | 'inline' | 'columns')
{%- endcomment -%}
{%- liquid
  assign tiers = 'top,heart,base' | split: ','
  assign has_any = false
  for t in tiers
    assign key = t | append: '_notes'
    if product.metafields.velreya[key] != blank
      assign has_any = true
    endif
  endfor
-%}
{%- if has_any -%}
  <dl class="notes notes--{{ style | default: 'stacked' }}">
    {%- for t in tiers -%}
      {%- assign key = t | append: '_notes' -%}
      {%- assign mf = product.metafields.velreya[key] -%}
      {%- if mf != blank -%}
        {%- if mf.type contains 'list' -%}
          {%- assign list = mf.value -%}
        {%- else -%}
          {%- assign list = mf.value | split: ',' -%}
        {%- endif -%}
        <div class="notes__tier">
          {%- assign icon_name = 'note-' | append: t -%}
          {%- assign label_key = 'fragrance.' | append: t -%}
          <dt class="notes__label">{% render 'icon', name: icon_name, size: 18 %}<span>{{ label_key | t }}</span></dt>
          <dd class="notes__list">
            {%- for n in list -%}<span>{{ n | strip }}</span>{%- unless forloop.last -%}<i aria-hidden="true">·</i>{%- endunless -%}{%- endfor -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>
{%- else -%}
  {%- liquid
    assign cat_entry = nil
    assign key = product.handle | downcase
    assign cat_lines = settings.fragrance_catalog | newline_to_br | replace: '<br>', '<br />' | split: '<br />'
    for l in cat_lines
      assign parts = l | strip | split: '|'
      if parts.size > 8
        assign h = parts[0] | strip | downcase
        if h == key
          assign cat_entry = parts
          break
        endif
      endif
    endfor
  -%}
  {%- if cat_entry -%}
    <dl class="notes notes--{{ style | default: 'stacked' }}">
      {%- for t in tiers -%}
        {%- liquid
          case t
            when 'top'
              assign list = cat_entry[6] | split: ','
            when 'heart'
              assign list = cat_entry[7] | split: ','
            else
              assign list = cat_entry[8] | split: ','
          endcase
          assign icon_name = 'note-' | append: t
          assign label_key = 'fragrance.' | append: t
        -%}
        <div class="notes__tier">
          <dt class="notes__label">{% render 'icon', name: icon_name, size: 18 %}<span>{{ label_key | t }}</span></dt>
          <dd class="notes__list">
            {%- for n in list -%}<span>{{ n | strip }}</span>{%- unless forloop.last -%}<i aria-hidden="true">·</i>{%- endunless -%}{%- endfor -%}
          </dd>
        </div>
      {%- endfor -%}
    </dl>
  {%- elsif request.design_mode -%}
    <p class="editor-hint">{{ 'fragrance.notes_missing_hint' | t }}</p>
  {%- endif -%}
{%- endif -%}
