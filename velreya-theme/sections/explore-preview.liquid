{%- assign s = section.settings -%}
<section class="explore2" aria-labelledby="ExploreTeaser-{{ section.id }}">
  <div class="container container--wide">
    <div class="explore2__box" data-reveal>
      <span class="explore2__glow" aria-hidden="true"></span>
      {%- if s.image != blank -%}<div class="explore2__media" aria-hidden="true">{% render 'image', image: s.image, sizes: '100vw', class: 'explore2__img' %}</div>{%- endif -%}
      {%- if s.video != blank -%}
        <video class="explore-teaser__video" muted playsinline loop preload="none" data-lazy-video aria-hidden="true">
          {%- for source in s.video.sources -%}{%- if source.mime_type == 'video/mp4' -%}<source data-src="{{ source.url }}" type="video/mp4">{%- endif -%}{%- endfor -%}
        </video>
      {%- endif -%}
      <p class="eyebrow">{{ s.eyebrow }}</p>
      <h2 class="display explore2__title" id="ExploreTeaser-{{ section.id }}">{{ s.title }}</h2>
      {%- if s.text != blank -%}<p class="explore2__text">{{ s.text }}</p>{%- endif -%}
      <a class="btn btn--line" href="{{ s.link | default: '#' }}">{{ s.cta }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Explore teaser",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "video", "id": "video", "label": "Short ambient loop (optional)", "info": "Loads only when visible." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "VELREYA Explore" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Every fragrance has a <em>story.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Step inside each creation — its mood, its notes, its world." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Enter the experience" },
    { "type": "url", "id": "link", "label": "Link", "info": "Your Explore page, for example /pages/explore" }
  ],
  "presets": [ { "name": "Explore teaser" } ]
}
{% endschema %}
