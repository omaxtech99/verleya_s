<section class="account section--ivory">
  <div class="container container--narrow account__card">
    <h1 class="display account__title">{{ 'customer.reset_password' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPw">{{ 'customer.password' | t }}</label><input id="ResetPw" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPw2">{{ 'customer.password_confirm' | t }}</label><input id="ResetPw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--dark">{{ 'customer.reset_password' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
