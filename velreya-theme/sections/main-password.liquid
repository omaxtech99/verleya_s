<section class="password-page section--dark">
  <div class="notfound__glow" aria-hidden="true"></div>
  <div class="container notfound__inner">
    <span class="wordmark wordmark--lg">{{ shop.name | upcase }}</span>
    <h1 class="display notfound__title">{{ section.settings.title }}</h1>
    {%- if shop.password_message != blank -%}<p class="notfound__text">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'newsletter.success' | t }}</p>{%- else -%}
        <div class="field field--inline">
          <label class="visually-hidden" for="PwEmail">{{ 'newsletter.email' | t }}</label>
          <input id="PwEmail" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="btn btn--ivory">{{ 'password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password-page__login">
      <summary>{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field field--inline">
          <label class="visually-hidden" for="StorePassword">{{ 'password.password' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="btn btn--ghost">{{ 'password.enter_button' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [ { "type": "text", "id": "title", "label": "Heading", "default": "Opening soon" } ] }
{% endschema %}
