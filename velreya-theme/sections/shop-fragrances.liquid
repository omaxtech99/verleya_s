{%- liquid
  assign s = section.settings
  assign col = s.collection | default: settings.discovery_collection | default: collections.all
  assign lines = settings.fragrance_catalog | newline_to_br | replace: '<br>', '<br />' | split: '<br />'
-%}
<section class="showcase2" aria-labelledby="Showcase-{{ section.id }}">
  <div class="container container--wide showcase2__head">
    <div>
      <p class="eyebrow" data-reveal>{{ s.eyebrow }}</p>
      <h2 class="display showcase2__title" id="Showcase-{{ section.id }}" data-reveal>{{ s.title }}</h2>
    </div>
    <div class="showcase2__aside" data-reveal>
      {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
      <div class="carousel-nav" data-carousel-nav>
        <button type="button" class="arrow-btn" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', size: 18 %}</button>
        <button type="button" class="arrow-btn" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</button>
      </div>
    </div>
  </div>

  <editorial-carousel class="showcase__track" tabindex="0" aria-label="{{ s.title | strip_html | escape }}">
    <ul class="showcase__list" role="list" data-carousel-track>
      {%- assign n = 0 -%}
      {%- for line in lines -%}
        {%- assign f = line | strip | split: '|' -%}
        {%- if f.size < 9 -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign n = n | plus: 1
          assign f_handle = f[0] | strip | downcase
          assign fp = nil
          for p in col.products
            if p.handle == f_handle
              assign fp = p
              break
            endif
          endfor
        -%}
        <li class="showcase__item showcase__item--{{ n | modulo: 3 }}">
          {% render 'fragrance-card', f: f, fp: fp, index: n, fallback_url: col.url %}
        </li>
      {%- endfor -%}
    </ul>
    <div class="showcase__progress" aria-hidden="true"><span data-carousel-progress></span></div>
  </editorial-carousel>

  <div class="container container--wide showcase__foot">
    <a class="btn btn--line" href="{{ col.url | default: routes.all_products_collection_url }}">{{ s.cta }}</a>
  </div>
</section>
{% schema %}
{
  "name": "Shop the fragrances",
  "settings": [
    { "type": "paragraph", "content": "Shows the Fragrance catalog. Prices and links come from the matching products in this collection." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The Collection" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Twelve ways to be <em>remembered.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Each VELREYA creation has its own character. Find the one that feels like yours." },
    { "type": "text", "id": "cta", "label": "Button", "default": "View all fragrances" }
  ],
  "presets": [ { "name": "Shop the fragrances" } ]
}
{% endschema %}
