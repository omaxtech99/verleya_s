{%- liquid
  assign s = section.settings
  assign link_product = s.product
-%}
<section class="hero2" data-hero>
  <div class="hero2__glow" aria-hidden="true"></div>
  <div class="hero2__grain" aria-hidden="true"></div>
  <div class="container container--wide hero2__grid">
    <div class="hero2__copy">
      {%- if s.eyebrow != blank -%}<p class="eyebrow eyebrow--gold hero2__eyebrow" data-hero-line>{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="display hero2__title" data-hero-line>{{ s.title }}</h1>
      {%- if s.subtitle != blank -%}<p class="hero2__sub" data-hero-line>{{ s.subtitle }}</p>{%- endif -%}
      <div class="hero2__ctas" data-hero-line>
        {%- if s.cta1_label != blank -%}<a class="btn btn--line" href="{{ s.cta1_link | default: routes.all_products_collection_url }}">{{ s.cta1_label }}</a>{%- endif -%}
        {%- if s.cta2_label != blank -%}<a class="lnk" href="{{ s.cta2_link | default: '#' }}">{{ s.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
    <a class="hero2__bottle" href="{{ link_product.url | default: s.bottle_link | default: routes.all_products_collection_url }}" aria-label="{{ s.bottle_caption | escape }}">
      <span class="hero2__halo" aria-hidden="true"></span>
      <span class="hero2__float" data-parallax="-0.06">
        {%- assign hero_img = s.image | default: link_product.featured_image -%}
        {% render 'bottle-image', image: hero_img, sizes: '(min-width: 990px) 34vw, 80vw', class: 'hero2__img', loading: 'eager', alt: s.bottle_caption %}
      </span>
      {%- if s.bottle_caption != blank -%}<span class="lnk hero2__caption">{{ s.bottle_caption }}</span>{%- endif -%}
    </a>
  </div>
  <div class="hero2__scroll" aria-hidden="true"><span></span>{{ 'general.scroll' | t }}</div>
</section>

{% schema %}
{
  "name": "Cinematic hero",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bottle photograph", "info": "Black-ground bottle photo, portrait. Defaults to the selected product's image, then the VELREYA bottle." },
    { "type": "product", "id": "product", "label": "Bottle links to product" },
    { "type": "url", "id": "bottle_link", "label": "Bottle link (if no product)" },
    { "type": "text", "id": "bottle_caption", "label": "Bottle caption", "default": "Velour — View fragrance" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Twelve Eau de Parfum" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "info": "Italic text is shown in champagne gold.", "default": "The art of being <em>unforgettable.</em>" },
    { "type": "text", "id": "subtitle", "label": "Supporting line", "default": "Some impressions never fade." },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Discover the collection" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link", "default": "Explore VELREYA" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link URL" }
  ],
  "presets": [ { "name": "Cinematic hero" } ]
}
{% endschema %}
