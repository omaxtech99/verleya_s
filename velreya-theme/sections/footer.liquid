<footer class="footer section--dark">
  <div class="container container--wide">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 520 | image_tag: class: 'logo', alt: shop.name, widths: '260, 520', sizes: '260px' }}
          {%- else -%}
            <span class="wordmark wordmark--lg">{{ shop.name | upcase }}</span>
          {%- endif -%}
        </a>
        {%- if settings.brand_tagline != blank -%}<p class="footer__tagline">{{ settings.brand_tagline }}</p>{%- endif -%}
        {% render 'social-icons' %}
      </div>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__col" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | default: block.settings.menu.title | escape }}">
              <h2 class="footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
              <ul role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
      <nav class="footer__col" aria-label="{{ 'footer.customer_care' | t }}">
        <h2 class="footer__heading">{{ 'footer.customer_care' | t }}</h2>
        <ul role="list">
          {%- if shop.shipping_policy -%}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{%- endif -%}
          {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{%- endif -%}
          {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{%- endif -%}
          {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{%- endif -%}
          {%- if shop.contact_information -%}<li><a href="{{ shop.contact_information.url }}">{{ shop.contact_information.title }}</a></li>{%- endif -%}
          {%- if shop.customer_accounts_enabled -%}
            {%- if customer -%}
              <li><a href="{{ routes.account_url }}">{{ 'customer.account' | t }}</a></li>
            {%- else -%}
              <li><a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
      {%- if section.settings.show_payment -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'footer__localization' -%}
          <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {%- for c in localization.available_countries -%}
              <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] },
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4
}
{% endschema %}
