<footer class="footer2">
  <div class="container container--wide">
    <div class="footer2__top">
      {%- if section.settings.show_newsletter -%}
        <div class="footer2__news">
          <p class="eyebrow">{{ section.settings.newsletter_label }}</p>
          {%- if section.settings.newsletter_text != blank -%}<p class="footer2__newstext">{{ section.settings.newsletter_text }}</p>{%- endif -%}
          {%- form 'customer', class: 'footer2__form', id: 'FooterNewsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
            {%- else -%}
              <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email' | t }}</label>
              <input id="FooterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.your_email' | t }}">
              <button type="submit" class="eyebrow">{{ 'newsletter.subscribe' | t }}</button>
              {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
      <nav class="footer2__nav" aria-label="{{ 'footer.nav' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <ul role="list" {{ block.shopify_attributes }}>
              {%- for link in block.settings.menu.links -%}<li><a class="eyebrow" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endfor -%}
        <ul role="list">
          {%- if shop.shipping_policy -%}<li><a class="eyebrow" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{%- endif -%}
          {%- if shop.refund_policy -%}<li><a class="eyebrow" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{%- endif -%}
          {%- if shop.privacy_policy -%}<li><a class="eyebrow" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{%- endif -%}
          {%- if shop.terms_of_service -%}<li><a class="eyebrow" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{%- endif -%}
          {%- if shop.customer_accounts_enabled -%}<li><a class="eyebrow" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{% if customer %}{{ 'customer.account' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}</a></li>{%- endif -%}
        </ul>
        <div>{% render 'social-icons' %}</div>
      </nav>
    </div>

    <div class="footer2__logo" data-reveal>
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 1200 | image_tag: alt: shop.name, widths: '600, 1200', sizes: '(min-width: 990px) 560px, 90vw', loading: 'lazy' }}
      {%- else -%}
        <img src="{{ 'velreya-logo.png' | asset_url }}" width="493" height="303" alt="{{ shop.name }}" loading="lazy">
      {%- endif -%}
    </div>

    <div class="footer2__bottom">
      <span class="eyebrow eyebrow--sm">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      {%- if section.settings.show_payment and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if localization.available_countries.size > 1 -%}
        {%- form 'localization', class: 'footer__localization' -%}
          <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
          <select id="FooterCountry" name="country_code" onchange="this.form.submit()">
            {%- for c in localization.available_countries -%}
              <option value="{{ c.iso_code }}"{% if c.iso_code == localization.country.iso_code %} selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }})</option>
            {%- endfor -%}
          </select>
        {%- endform -%}
      {%- else -%}
        <span class="eyebrow eyebrow--sm">{{ localization.country.name }} · {{ cart.currency.iso_code }}</span>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_label", "label": "Newsletter label", "default": "Newsletter" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New creations, private previews and stories from the house." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ] }
  ],
  "max_blocks": 3
}
{% endschema %}
