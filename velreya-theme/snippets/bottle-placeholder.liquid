{%- comment -%}
  Neutral bottle silhouette shown ONLY when a product or section has no image yet.
  Replace by uploading real VELREYA photography in Shopify admin.
  Params: variant ('full' | 'mini'), tint (css color), label (string)
{%- endcomment -%}
{%- assign uid = 'bp' | append: section.id | append: forloop.index | append: label | handle -%}
<svg class="bottle-placeholder{% if variant == 'mini' %} bottle-placeholder--mini{% endif %}" viewBox="0 0 200 320" role="img" aria-label="{{ label | default: 'Bottle image coming soon' | escape }}" preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id="{{ uid }}-g" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#ffffff" stop-opacity=".03"/>
      <stop offset=".22" stop-color="#ffffff" stop-opacity=".16"/>
      <stop offset=".5" stop-color="#ffffff" stop-opacity=".04"/>
      <stop offset=".86" stop-color="#ffffff" stop-opacity=".12"/>
      <stop offset="1" stop-color="#ffffff" stop-opacity=".02"/>
    </linearGradient>
    <linearGradient id="{{ uid }}-l" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0" stop-color="{{ tint | default: '#C5A875' }}" stop-opacity=".18"/>
      <stop offset="1" stop-color="{{ tint | default: '#C5A875' }}" stop-opacity=".55"/>
    </linearGradient>
  </defs>
  {%- if variant == 'mini' -%}
    <rect x="82" y="40" width="36" height="46" rx="3" fill="#1d1b19" stroke="#C5A875" stroke-opacity=".5"/>
    <rect x="70" y="92" width="60" height="190" rx="10" fill="url(#{{ uid }}-l)"/>
    <rect x="70" y="92" width="60" height="190" rx="10" fill="url(#{{ uid }}-g)" stroke="#F1EBE1" stroke-opacity=".22"/>
    <text x="100" y="196" text-anchor="middle" font-size="8" letter-spacing="3" fill="#F1EBE1" fill-opacity=".7" font-family="serif">VELREYA</text>
  {%- else -%}
    <rect x="74" y="18" width="52" height="56" rx="4" fill="#1d1b19" stroke="#C5A875" stroke-opacity=".5"/>
    <rect x="88" y="74" width="24" height="14" fill="#C5A875" fill-opacity=".45"/>
    <rect x="30" y="88" width="140" height="214" rx="14" fill="url(#{{ uid }}-l)"/>
    <rect x="30" y="88" width="140" height="214" rx="14" fill="url(#{{ uid }}-g)" stroke="#F1EBE1" stroke-opacity=".22"/>
    <text x="100" y="200" text-anchor="middle" font-size="12" letter-spacing="5" fill="#F1EBE1" fill-opacity=".75" font-family="serif">VELREYA</text>
  {%- endif -%}
</svg>
