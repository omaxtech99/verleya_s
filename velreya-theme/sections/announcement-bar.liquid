{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Text", "info": "Only publish offers and service promises you actually provide." },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
