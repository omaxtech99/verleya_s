<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_black }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- unless settings.font_heading.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_heading | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.font_body.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_body | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'velreya.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Velreya = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          search: {{ routes.search_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        predictive: {{ settings.predictive_search | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToBag: {{ 'products.add_to_bag' | t | json }},
          adding: {{ 'products.adding' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          selectFour: {{ 'discovery.select_n' | t: count: settings.discovery_count | json }},
          addSet: {{ 'discovery.add_set' | t | json }},
          selected: {{ 'discovery.selected' | t | json }},
          limitReached: {{ 'discovery.limit_reached' | t: count: settings.discovery_count | json }},
          added: {{ 'discovery.added' | t | json }},
          remove: {{ 'general.remove' | t | json }},
          notReady: {{ 'discovery.not_ready' | t | json }},
          playVideo: {{ 'general.play_video' | t | json }},
          pauseVideo: {{ 'general.pause_video' | t | json }}
        }
      };
    </script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}{% if settings.enable_reveal %} has-reveal{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {% render 'discovery-modal' %}

    {% render 'search-overlay' %}

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>
  </body>
</html>
