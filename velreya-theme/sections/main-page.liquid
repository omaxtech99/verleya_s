<section class="page-main section--{{ section.settings.scheme }}">
  <div class="container container--narrow">
    <h1 class="display page-main__title">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Page content",
  "settings": [ { "type": "select", "id": "scheme", "label": "Color scheme", "options": [ { "value": "ivory", "label": "Ivory" }, { "value": "dark", "label": "Black" } ], "default": "ivory" } ]
}
{% endschema %}
