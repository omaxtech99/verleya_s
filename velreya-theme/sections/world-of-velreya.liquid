{%- assign s = section.settings -%}
<section class="statement section--{{ s.scheme }}">
  <div class="container container--wide statement__grid">
    <div class="statement__copy">
      <p class="eyebrow" data-reveal>{{ s.eyebrow }}</p>
      <h2 class="display display--break statement__title" data-reveal>{{ s.title }}</h2>
      <span class="hairline" data-reveal aria-hidden="true"></span>
      <div class="statement__text" data-reveal>{{ s.text }}</div>
      {%- if s.cta != blank and s.link != blank -%}<a class="lnk" href="{{ s.link }}" data-reveal>{{ s.cta }}</a>{%- endif -%}
    </div>
    <figure class="statement__media" data-reveal>
      <span class="statement__frame" aria-hidden="true"></span>
      <span class="statement__inner" data-parallax="0.05">
        {%- if s.image != blank -%}
          {% render 'image', image: s.image, sizes: '(min-width: 990px) 36vw, 90vw', class: 'statement__img' %}
        {%- else -%}
          {% render 'bottle-image', sizes: '(min-width: 990px) 30vw, 70vw', class: 'statement__bottle' %}
        {%- endif -%}
      </span>
      {%- if s.caption != blank -%}<figcaption class="eyebrow">{{ s.caption }}</figcaption>{%- endif -%}
    </figure>
  </div>
</section>
{% schema %}
{
  "name": "Statement",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [ { "value": "dark", "label": "Black" }, { "value": "charcoal", "label": "Charcoal" }, { "value": "ivory", "label": "Ivory" } ], "default": "dark" },
    { "type": "image_picker", "id": "image", "label": "Campaign image", "info": "Defaults to the VELREYA bottle." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The House" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Fragrance is an art. <em>Presence is its expression.</em>" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Fragrance is invisible, but its presence can be remembered. Twelve fragrances, each with a personality of its own, drawn together as one collection.</p>" },
    { "type": "text", "id": "caption", "label": "Image caption" },
    { "type": "text", "id": "cta", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Statement" } ]
}
{% endschema %}
