<search-overlay class="search-overlay" id="SearchOverlay" hidden>
  <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay__form">
      <input type="hidden" name="type" value="product">
      <label class="visually-hidden" for="SearchOverlayInput">{{ 'search.placeholder' | t }}</label>
      {% render 'icon', name: 'search', size: 22 %}
      <input id="SearchOverlayInput" type="search" name="q" autocomplete="off" placeholder="{{ 'search.placeholder' | t }}" data-search-input
        role="combobox" aria-expanded="false" aria-controls="PredictiveResults" aria-autocomplete="list">
      <button type="button" class="icon-btn" data-search-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </form>
    <div class="search-overlay__results" id="PredictiveResults" data-search-results aria-live="polite"></div>
  </div>
</search-overlay>
