{%- assign s = section.settings -%}
<section class="richtext section--{{ s.scheme }}">
  <div class="container container--narrow richtext__inner richtext__inner--{{ s.align }}" data-reveal>
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    {%- if s.title != blank -%}<h2 class="display richtext__title">{{ s.title }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rte richtext__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.cta != blank and s.link != blank -%}<a class="btn btn--outline" href="{{ s.link }}">{{ s.cta }}</a>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [ { "value": "dark", "label": "Black" }, { "value": "ivory", "label": "Ivory" }, { "value": "charcoal", "label": "Charcoal" } ], "default": "dark" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ { "value": "center", "label": "Center" }, { "value": "left", "label": "Left" } ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta", "label": "Button" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}
