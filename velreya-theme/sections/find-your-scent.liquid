{%- liquid
  assign s = section.settings
  assign lines = settings.fragrance_catalog | newline_to_br | replace: '<br>', '<br />' | split: '<br />'
-%}
<section class="signature" aria-labelledby="Sig-{{ section.id }}">
  <div class="container container--wide">
    <div class="signature__head">
      <div>
        <p class="eyebrow" data-reveal>{{ s.eyebrow }}</p>
        <h2 class="display signature__title" id="Sig-{{ section.id }}" data-reveal>{{ s.title }}</h2>
      </div>
      {%- if s.text != blank -%}<p class="signature__text" data-reveal>{{ s.text }}</p>{%- endif -%}
    </div>
    <cursor-preview class="signature__list">
      <span class="signature__cursor" aria-hidden="true" data-cursor>{% render 'bottle-image', sizes: '180px', alt: '' %}</span>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign wanted = block.settings.handles | downcase | split: ','
          assign names = ''
          assign accent = settings.color_gold
          for w in wanted
            assign wh = w | strip
            for line in lines
              assign f = line | strip | split: '|'
              if f.size > 8
                assign h = f[0] | strip | downcase
                if h == wh
                  assign nm = f[1] | strip | capitalize
                  if names == ''
                    assign names = nm
                    assign accent = f[4] | strip
                  else
                    assign names = names | append: ' · ' | append: nm
                  endif
                endif
              endif
            endfor
          endfor
        -%}
        <a class="signature__row" href="{{ c.url | default: routes.all_products_collection_url }}" style="--accent: {{ accent }};" {{ block.shopify_attributes }} data-reveal>
          <span class="signature__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="signature__name">{{ block.settings.label | default: c.title }}</span>
          <span class="eyebrow signature__members">{{ names | default: block.settings.mood }}</span>
          <span class="signature__arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 20 %}</span>
        </a>
      {%- endfor -%}
    </cursor-preview>
    {%- if s.cta != blank -%}<div class="signature__foot" data-reveal><a class="btn btn--line" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.cta }}</a></div>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Find your signature",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Find Your Signature" },
    { "type": "inline_richtext", "id": "title", "label": "Heading", "default": "Choose by <em>character.</em>" },
    { "type": "text", "id": "text", "label": "Text", "default": "Proposed families to guide you. Every fragrance is personal." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Find your signature" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "family", "name": "Scent family", "settings": [
      { "type": "text", "id": "label", "label": "Family name" },
      { "type": "text", "id": "handles", "label": "Fragrances (catalog handles, comma separated)", "info": "For example azure, solara" },
      { "type": "collection", "id": "collection", "label": "Links to collection", "info": "For example an automated collection of this family." },
      { "type": "text", "id": "mood", "label": "Fallback description" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Find your signature", "blocks": [
    { "type": "family", "settings": { "label": "Fresh", "handles": "azure, solara" } },
    { "type": "family", "settings": { "label": "Floral", "handles": "rouge, lumi, blanc" } },
    { "type": "family", "settings": { "label": "Woody", "handles": "terra, cuir" } },
    { "type": "family", "settings": { "label": "Warm & Spicy", "handles": "ember, nova" } },
    { "type": "family", "settings": { "label": "Gourmand", "handles": "velour, ambre" } },
    { "type": "family", "settings": { "label": "Soft & Musky", "handles": "aura, lumi" } }
  ] } ]
}
{% endschema %}
